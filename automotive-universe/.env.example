# ─── AUTOMOTIVE UNIVERSE — configuration de l'agent de production ───
# Copier en .env sur le serveur. Ne JAMAIS committer le vrai fichier .env.

PORT=8080
TZ_AGENT=Europe/Paris
DATA_DIR=./data

# Jeton d'administration (API, tableau de bord, agentctl). 32+ caractères aléatoires :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Chemin secret du connecteur MCP pour l'app Claude (URL = https://votre-agent/mcp/<MCP_PATH_SECRET>)
MCP_PATH_SECRET=

# ─── Budget (en euros) — 0 = AUCUNE dépense payante autorisée ───
BUDGET_MONTHLY_EUR=0
BUDGET_ALERT_THRESHOLDS=0.5,0.8,1
USD_TO_EUR=0.93

# ─── IA ─── none = aucune IA payante (modèles de scripts + fiches importées)
LLM_PROVIDER=none
# Clé API Anthropic SÉPARÉE de l'abonnement Claude Pro (console.anthropic.com, facturation à l'usage)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# ─── Publication ─── dry_run = rien n'est envoyé à TikTok
PUBLISH_MODE=dry_run
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Visibilité par défaut tant que l'application TikTok n'est pas auditée
TIKTOK_PRIVACY=SELF_ONLY

# ─── Production ───
VIDEOS_PER_DAY=2
PUBLISH_SLOTS=12:30,19:00
RSS_FEEDS=
# Commande de synthèse vocale locale gratuite (optionnelle), ex. Piper :
#   TTS_CMD=piper --model fr_FR-siwis-medium.onnx --output_file {out}
TTS_CMD=

# ─── Alertes ─── notifications iPhone gratuites via l'app ntfy (sujet privé, long et aléatoire)
ALERT_NTFY_URL=
ALERT_WEBHOOK_URL=
