# ELYSÉA — variables d'environnement (copier en .env ou définir chez l'hébergeur)

# Obligatoire en production
NODE_ENV=production
PORT=8790
SITE_URL=https://www.votre-domaine.fr          # URL publique (canonical, sitemap, e-mails, Stripe)
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long  # accès à /admin (désactivé si absent en production)

# Paiement — Stripe Checkout (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                 # endpoint : https://votre-domaine/api/stripe/webhook

# E-mails transactionnels — Resend (https://resend.com). Sans clé : mode « outbox » (journal dans l'admin).
RESEND_API_KEY=
MAIL_FROM=ELYSÉA <commandes@votre-domaine.fr>

# Stockage des données (commandes, réglages, photos importées). Monter un volume persistant.
DATA_DIR=/data

# Démonstration en production (déconseillé) : autorise le paiement simulé si Stripe est absent.
# ALLOW_DEMO_PAYMENTS=1
